# Anthropic API key for Claude Haiku 4.5 fallback
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Service bind
CLF_HOST=127.0.0.1
CLF_PORT=8765

# Auth (recommended in multi-user / shared box)
CLF_BRIDGE_TOKEN=change-me-to-a-long-random-string

# Behavior
CLF_FAIL_OPEN_ON_ERROR=true
CLF_ENABLE_CLAUDE_FALLBACK=true
CLF_CLAUDE_MODEL=claude-haiku-4-5
CLF_CLAUDE_TIMEOUT_S=8

# Logging
CLF_LOG_FILE=logs/decisions.jsonl
CLF_LOG_LEVEL=INFO